package views

import (
	"fmt"
	"slices"
	"strings"
)

// tileSections is the fixed category order the dashboard groups tiles
// into — mirrors Apple Health's own Browse grouping (Activity, Heart, Body
// Measurements, Sleep, Respiratory) rather than one flat grid of same-weight
// tiles.
var tileSections = []struct{ Key, Title string }{
	{"activity", "Activity"},
	{"heart", "Heart"},
	{"body", "Body Measurements"},
	{"sleep", "Sleep"},
	{"respiratory", "Respiratory"},
	{"nutrition", "Nutrition"},
}

func tilesForCategory(tiles []TileData, category string) []TileData {
	var out []TileData
	for _, t := range tiles {
		if t.Category == category {
			out = append(out, t)
		}
	}
	return out
}

// Dashboard renders every section that has something to show.
// data.Tiles already excludes tiles with no data for the day (see
// shouldHideEmptyTile in handlers.go) — those titles are collected in
// data.MissingByCategory instead and rendered as one compact
// EmptySummaryTile per section, so a section with some data and some empty
// metrics doesn't lose track of what's missing, and a section that's
// entirely empty still renders one small tile naming what's missing rather
// than vanishing and leaving an inconsistent gap in the page's rhythm.
// "nutrition" always renders regardless, since its Cronometer account card
// (connect prompt or status) needs to stay reachable even with no metrics
// synced yet.
templ Dashboard(data DashboardData) {
	<div class="dashboard" id="dashboard-grid">
		for _, section := range tileSections {
			{{ tiles := tilesForCategory(data.Tiles, section.Key) }}
			{{ missing := data.MissingByCategory[section.Key] }}
			if len(tiles) > 0 || len(missing) > 0 || section.Key == "nutrition" {
				<section class="dashboard-section">
					<h2 class="section-title">{ section.Title }</h2>
					if section.Key == "nutrition" {
						@NutritionSection(tiles, missing, data.Day, data.CronometerConnected, data.CronometerMessage)
					} else {
						<div class="dashboard-grid">
							for _, t := range tiles {
								@Tile(t, data.Day)
							}
							if len(missing) > 0 {
								@EmptySummaryTile(missing)
							}
						</div>
					}
				</section>
			}
		}
	</div>
}

// NutritionSection lays the Nutrition category out as two explicit rows —
// kcal metrics (Energy/Expenditure/Deficit), then the 3 macros — followed
// by the detailed food log, an EmptySummaryTile for whichever of those had
// no data, and the Cronometer account card, rather than leaving all 6 stat
// tiles to whatever the general dashboard-grid's auto-fill happens to wrap
// into at the current viewport width.
templ NutritionSection(tiles []TileData, missing []string, day string, cronometerConnected bool, cronometerMessage string) {
	{{ kcalTiles, macroTiles, foodLogTile := splitNutritionTiles(tiles) }}
	if len(kcalTiles) > 0 {
		<div class="nutrition-row">
			for _, t := range kcalTiles {
				@Tile(t, day)
			}
		</div>
	}
	if len(macroTiles) > 0 {
		<div class="nutrition-row">
			for _, t := range macroTiles {
				@Tile(t, day)
			}
		</div>
	}
	if foodLogTile != nil {
		@Tile(*foodLogTile, day)
	}
	if len(missing) > 0 {
		<div class="nutrition-row">
			@EmptySummaryTile(missing)
		</div>
	}
	@CronometerAccountCard(cronometerConnected, cronometerMessage)
}

// EmptySummaryTile is the compact stand-in for every metric that had no
// data today (see shouldHideEmptyTile in handlers.go) — one small, low-
// emphasis tile per section listing what's missing, instead of either a
// full-size empty placeholder per metric or the section silently vanishing.
templ EmptySummaryTile(titles []string) {
	<div class="tile tile-empty-summary">
		<span class="tile-empty-summary-label">No data today:</span>
		<span class="tile-empty-summary-list">{ strings.Join(titles, " · ") }</span>
	</div>
}

// splitNutritionTiles buckets the Nutrition category's tiles by their known
// kind strings (see DefaultTileKinds) rather than by position, so the
// grouping stays correct regardless of what order buildDashboardData built
// them in.
func splitNutritionTiles(tiles []TileData) (kcal, macro []TileData, foodLog *TileData) {
	for _, t := range tiles {
		switch nutritionBucket(t.Metric) {
		case "kcal":
			kcal = append(kcal, t)
		case "macro":
			macro = append(macro, t)
		case "food_log":
			ft := t
			foodLog = &ft
		}
	}
	return kcal, macro, foodLog
}

func nutritionBucket(metric string) string {
	switch metric {
	case "nutrition_energy", "nutrition_expenditure", "nutrition_deficit":
		return "kcal"
	case "nutrition_protein", "nutrition_carbs", "nutrition_fat":
		return "macro"
	case "food_log":
		return "food_log"
	}
	return ""
}

// tileGroup is the set of tiles t can be dragged among: its section, or
// for Nutrition, its own row (see NutritionSection) — a drop target outside
// the dragged tile's own grid container would make no visual sense.
func tileGroup(t TileData) string {
	if t.Category == "nutrition" {
		return "nutrition-" + nutritionBucket(t.Metric)
	}
	return t.Category
}

// isBodyStatTile: the weight/waist/neck/body-fat tiles, always expanded
// (see defaultExpandedKind in handlers.go).
func isBodyStatTile(metric string) bool {
	switch metric {
	case "weight", "waist", "neck", "body_fat":
		return true
	}
	return false
}

func fullWidthExpanded(t TileData) bool {
	return t.Expanded && t.Kind != TileKindStat && t.Kind != TileKindSleep
}

// tileResizable: only an expanded tile can be resized (see
// static/tile-resize.js); the food log sits outside any grid (see
// NutritionSection), so a column span would do nothing for it.
func tileResizable(t TileData) bool {
	return t.Expanded && t.Metric != "food_log"
}

func tileSpanClass(t TileData) string {
	if t.Expanded && t.Width > 0 {
		return fmt.Sprintf("tile-span-%d", t.Width)
	}
	return ""
}

templ Tile(t TileData, day string) {
	<div
		id={ t.ID }
		data-category={ t.Category }
		class={ "tile", templ.KV("tile-expanded", fullWidthExpanded(t)), tileSizeClass(t), tileSpanClass(t) }
		data-on:dragover={ tileDragOverExpr(tileGroup(t)) }
		data-on:drop={ tileDropExpr(t.Metric, tileGroup(t)) }
		if t.Expanded && t.Height > 0 {
			style={ fmt.Sprintf("min-height: %dpx", t.Height) }
		}
		if tileResizable(t) {
			data-resize-url={ tileResizeURL(t.Metric) }
		}
	>
		<div
			class="tile-header"
			draggable="true"
			title="Drag to reorder"
			data-on:dragstart={ tileDragStartExpr(t.Metric, tileGroup(t)) }
			data-on:dragend="$_dragGroup = ''"
		>
			<div class="tile-header-left">
				<span class="tile-icon-badge">
					@iconFor(t.Icon)
				</span>
				<span class="tile-title">{ t.Title }</span>
			</div>
			<div class="tile-header-actions">
				if isBodyStatTile(t.Metric) {
					// Always expanded: a range toggle instead of collapse.
					<button class="tile-range-btn" data-on:click={ getExpr(bodyRangeURL(t.Metric, day, !t.ShowAll)) }>
						if t.ShowAll {
							Last 14 days
						} else {
							Show all
						}
					</button>
				} else if t.Kind != TileKindBody && t.Kind != TileKindBodyHistory {
					if t.Expanded {
						<button class="tile-collapse-btn" data-on:click={ getExpr(tileURL(t.Metric, day, false)) } title="Collapse">
							@iconCollapse()
						</button>
					} else {
						<button class="tile-expand-btn" data-on:click={ getExpr(tileURL(t.Metric, day, true)) } title="Expand">
							@iconExpand()
						</button>
					}
				}
			</div>
		</div>
		<div class="tile-body">
			switch t.Kind {
				case TileKindStat:
					@statTileBody(t)
				case TileKindSleep:
					@statTileBody(t)
				case TileKindActivities:
					@activitiesTileBody(t)
				case TileKindBody:
					@bodyTileBody(t)
				case TileKindBodyHistory:
					@bodyHistoryTileBody(t)
				case TileKindFoodLog:
					@foodLogTileBody(t)
			}
		</div>
		if tileResizable(t) {
			<div class="tile-resize-handle tile-resize-x" data-resize="x" title="Drag to resize width"></div>
			<div class="tile-resize-handle tile-resize-y" data-resize="y" title="Drag to resize height"></div>
			<div class="tile-resize-handle tile-resize-xy" data-resize="xy" title="Drag to resize"></div>
		}
	</div>
}

func tileSizeClass(t TileData) string {
	if (t.Kind == TileKindStat || t.Kind == TileKindSleep) && (t.Chart != nil || t.Detail != nil) {
		return "tile-wide"
	}
	if t.Kind == TileKindActivities || t.Kind == TileKindBody || t.Kind == TileKindBodyHistory || t.Kind == TileKindFoodLog {
		return "tile-wide"
	}
	return ""
}

templ statTileBody(t TileData) {
	if t.Expanded && t.Detail != nil {
		@detailTileBody(t)
	} else if t.Empty {
		<div class="tile-empty">{ t.EmptyMsg }</div>
	} else if t.Chart != nil {
		<div class="tile-stat-header">
			<span class="tile-stat-sub">{ t.ChartSubtext }</span>
		</div>
		@templ.Raw(renderBarChartSVG(*t.Chart, chartInstanceID(t.ID)))
	} else {
		<div class="tile-value-row">
			<div>
				<div class="tile-big-value">{ t.BigValue } <span class="tile-unit">{ t.Unit }</span></div>
				if t.Subtext != "" {
					<div class="tile-subtext">{ t.Subtext }</div>
				}
			</div>
			if t.RingPct != nil {
				@stepRingSVG(*t.RingPct)
			}
		</div>
		if len(t.SparklineValues) > 0 {
			<div class="tile-sparkline">
				@templ.Raw(renderSparklineSVG(t.SparklineValues))
			</div>
		}
	}
}

// detailTileBody renders an expanded metric's rich detail view — an
// intraday heart-rate line or a sleep stage timeline — as opposed to the
// generic 14-day/hourly bar chart every other metric falls back to.
templ detailTileBody(t TileData) {
	if t.Detail.Message != "" {
		<div class="tile-empty">{ t.Detail.Message }</div>
	}
	if len(t.Detail.Stats) > 0 {
		<div class="detail-stats-row">
			for _, s := range t.Detail.Stats {
				<div class="detail-stat">
					<span class="detail-stat-value">{ s.Value }</span>
					if s.Sub != "" {
						<span class="detail-stat-sub">{ s.Sub }</span>
					}
					<span class="detail-stat-label">{ s.Label }</span>
				</div>
			}
		</div>
	}
	switch t.Detail.Kind {
		case "line":
			if len(t.Detail.LineSamples) > 0 {
				@templ.Raw(renderLineChartSVG(t.Detail.LineSamples, chartInstanceID(t.ID), t.Detail.LineUnit))
			}
		case "stages":
			if len(t.Detail.StageRows) > 0 {
				for i, row := range t.Detail.StageRows {
					if row.Label != "" {
						<div class="tile-stat-sub">{ row.Label }</div>
					}
					if len(row.Lanes) > 0 {
						@templ.Raw(renderLaneChartSVG(row.Stages, row.Lanes, row.Start, row.End, chartInstanceID(fmt.Sprintf("%s_%d", t.ID, i))))
					} else {
						@templ.Raw(renderStageTimelineSVG(row.Stages, chartInstanceID(fmt.Sprintf("%s_%d", t.ID, i))))
					}
				}
				@stageLegend(allStages(t.Detail.StageRows))
			}
	}
}

// stageLegend renders one dot+label per distinct segment type actually
// present, in first-seen order — shared by sleep stages (AWAKE/LIGHT/DEEP/
// REM) and heart-rate zone minutes (LIGHT/MODERATE/VIGOROUS/PEAK), so
// neither needs its own hardcoded legend.
templ stageLegend(stages []StageSegment) {
	<div class="stage-legend">
		for _, stageType := range distinctStageTypes(stages) {
			<span class="stage-legend-item">
				<span class={ "stage-dot", "stage-" + strings.ToLower(stageType) }></span>
				{ humanizeStageType(stageType) }
			</span>
		}
	</div>
}

// allStages flattens every row's segments, so the legend covers every
// stage type shown in any row.
func allStages(rows []StageRow) []StageSegment {
	var out []StageSegment
	for _, r := range rows {
		out = append(out, r.Stages...)
	}
	return out
}

func distinctStageTypes(stages []StageSegment) []string {
	var out []string
	seen := map[string]bool{}
	for _, s := range stages {
		if !seen[s.Type] {
			seen[s.Type] = true
			out = append(out, s.Type)
		}
	}
	// Types with a lane follow their lane chart's top-to-bottom order;
	// anything else keeps first-seen order.
	known := append(slices.Clone(SleepLanes), ActivityLanes...)
	lane := func(t string) int {
		for i, l := range known {
			if l.Type == t {
				return i
			}
		}
		return len(known)
	}
	slices.SortStableFunc(out, func(a, b string) int { return lane(a) - lane(b) })
	return out
}

// humanizeStageType handles both single-word stage types (sleep: AWAKE,
// LIGHT, DEEP, REM) and multi-word ones (activity level: LIGHTLY_ACTIVE,
// MODERATELY_ACTIVE, VERY_ACTIVE), splitting on "_" so the legend reads
// "Lightly Active" rather than "Lightly_active".
func humanizeStageType(s string) string {
	if s == "REM" {
		return s
	}
	if s == "" {
		return s
	}
	words := strings.Split(strings.ToLower(s), "_")
	for i, w := range words {
		if w == "" {
			continue
		}
		words[i] = strings.ToUpper(w[:1]) + w[1:]
	}
	return strings.Join(words, " ")
}

templ foodLogTileBody(t TileData) {
	if len(t.FoodLog) == 0 {
		<div class="tile-empty">No food logged</div>
	} else {
		<ul class="activity-list">
			for _, s := range t.FoodLog {
				<li>
					<button class="activity-item" data-on:click={ getExpr(foodServingURL(s.ID)) + "; $detailOpen = true" }>
						<span class="activity-main">
							<span class="activity-type">{ s.FoodName }</span>
							<span class="activity-meta">
								{ s.TimeLabel }
								if s.QuantityLabel != "" {
									&middot; { s.QuantityLabel }
								}
							</span>
						</span>
						<span class="activity-stats">
							<span class="activity-stat">{ fmt.Sprintf("%.0f kcal", s.EnergyKcal) }</span>
							if s.ProteinG != nil {
								<span class="activity-stat">{ fmt.Sprintf("%.0fg protein", *s.ProteinG) }</span>
							}
						</span>
					</button>
				</li>
			}
		</ul>
	}
}

templ activitiesTileBody(t TileData) {
	if len(t.Activities) == 0 {
		<div class="tile-empty">No activities</div>
	} else {
		<ul class="activity-list">
			for _, a := range t.Activities {
				<li>
					<button class="activity-item" data-on:click={ getExpr(activityURL(a.ID)) + "; $detailOpen = true" }>
						<span class="activity-main">
							<span class="activity-type">{ humanizeExerciseType(a.Type) }</span>
							<span class="activity-meta">{ a.StartLabel } &middot; { FormatMinutes(a.DurationMinutes) }</span>
						</span>
						<span class="activity-stats">
							<span class="activity-stat">{ fmt.Sprintf("%.0f kcal", a.CaloriesBurned) }</span>
							if a.AvgHeartRateBpm != nil {
								<span class="activity-stat">{ fmt.Sprintf("%.0f bpm", *a.AvgHeartRateBpm) }</span>
							}
						</span>
					</button>
				</li>
			}
		</ul>
	}
}
