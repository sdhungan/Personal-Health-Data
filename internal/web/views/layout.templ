package views

// Page is the full HTML document shell. Every full (non-SSE) page load
// renders this once; subsequent navigation morphs #view-body in place via
// Datastar SSE patches instead of reloading the page.
templ Page(data DashboardData) {
	<!DOCTYPE html>
	<html lang="en" data-signals={ initialSignals(data.Day) }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Personal Health Dashboard</title>
			@themeScript()
			<link rel="stylesheet" href="/static/style.css"/>
			<script type="module" src="/static/datastar.js"></script>
		</head>
		<body>
			@Header(data.Username)
			<main class="main">
				@DataViewBody(data)
			</main>
			<div id="detail-overlay" class="overlay" data-show="$detailOpen" style="display:none">
				<div class="overlay-backdrop" data-on:click="$detailOpen = false"></div>
				<div class="overlay-panel">
					<button class="overlay-close" data-on:click="$detailOpen = false">&times;</button>
					<div id="detail-panel"></div>
				</div>
			</div>
		</body>
	</html>
}

// themeScript detects the stored light/dark preference (see
// ThemeToggleButton) before first paint and stamps it onto <html> as
// data-theme, so every page — dashboard, login, settings, onboarding — opens
// in the theme the user last picked instead of flashing dark and then
// flipping. Included in every full-page <head> (not just the dashboard's),
// since the preference is app-wide, not a per-page setting. Unset defaults
// to "dark" — the app's original, only appearance until a user opts into
// light — rather than following the OS's own prefers-color-scheme.
templ themeScript() {
	<script>
		(function() {
			var theme = localStorage.getItem("healthd-theme") || "dark";
			document.documentElement.setAttribute("data-theme", theme);
		})();
	</script>
}

// ThemeToggleButton flips data-theme on <html> and persists the choice —
// both icons always render, CSS shows only the one matching the current
// theme (see style.css's [data-theme] selectors on .theme-toggle), so
// there's no server round-trip or Datastar signal needed for a purely
// cosmetic, per-browser preference.
templ ThemeToggleButton() {
	<button
		type="button"
		class="theme-toggle"
		title="Toggle light/dark theme"
		onclick="var next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light'; document.documentElement.setAttribute('data-theme', next); localStorage.setItem('healthd-theme', next);"
	>
		<span class="theme-toggle-sun">
			@iconSun()
		</span>
		<span class="theme-toggle-moon">
			@iconMoon()
		</span>
	</button>
}

templ Header(username string) {
	<header class="site-header">
		<a href="/" class="brand">
			<span class="brand-title">Personal Health Dashboard</span>
		</a>
		<nav class="site-nav">
			@ThemeToggleButton()
			if username != "" {
				<div class="user-menu">
					<button
						type="button"
						class="user-menu-trigger"
						title={ username }
						data-on:click="$userMenuOpen = !$userMenuOpen"
					>
						@iconUser()
					</button>
					<div class="user-menu-backdrop" data-show="$userMenuOpen" data-on:click="$userMenuOpen = false" style="display:none"></div>
					<div class="user-menu-dropdown" data-show="$userMenuOpen" style="display:none">
						<div class="user-menu-name">{ username }</div>
						<a class="user-menu-item" href="/settings/account" data-on:click="$userMenuOpen = false">
							@iconUser()
							Account
						</a>
						<a class="user-menu-item" href="/settings/google-client" data-on:click="$userMenuOpen = false">
							@iconSettingsGear()
							Google settings
						</a>
						<form method="post" action="/logout">
							<button type="submit" class="user-menu-item user-menu-item-btn">
								@iconLogout()
								Log out
							</button>
						</form>
					</div>
				</div>
			}
		</nav>
	</header>
}

// DataViewBody and JournalViewBody both render into the same #view-body
// id, so an SSE patch of either one morphs cleanly in place regardless of
// which view was previously showing.
templ DataViewBody(data DashboardData) {
	<div id="view-body">
		@ViewTabs(data)
		@DayNav(data)
		@Dashboard(data)
	</div>
}

templ JournalViewBody(data DashboardData, j JournalData) {
	<div id="view-body">
		@ViewTabs(data)
		@DayNav(data)
		@JournalView(data, j)
	</div>
}

templ ViewTabs(data DashboardData) {
	<div class="view-tabs">
		<button class={ "view-tab", templ.KV("active", data.View != "journal") } data-on:click={ getExpr(viewURL(data.Day, "data")) }>
			{ data.Day }/data
		</button>
		<button class={ "view-tab", templ.KV("active", data.View == "journal") } data-on:click={ getExpr(viewURL(data.Day, "journal")) }>
			{ data.Day }/journal
		</button>
	</div>
}

templ DayNav(data DashboardData) {
	<div class="day-nav">
		<button class="day-nav-btn" data-on:click={ getExpr(viewURL(data.PrevDay, data.View)) }>&lsaquo;</button>
		<button
			type="button"
			class="day-nav-label"
			title="Pick a date"
			data-on:click="document.getElementById('day-picker-input').showPicker()"
		>
			{ data.DayLabel }
		</button>
		<input
			type="date"
			id="day-picker-input"
			class="day-picker-input"
			value={ data.Day }
			data-on:change={ dayPickerChangeExpr(data.View) }
			tabindex="-1"
			aria-hidden="true"
		/>
		<button class="day-nav-btn" data-on:click={ getExpr(viewURL(data.NextDay, data.View)) }>&rsaquo;</button>
		if data.Day != data.Today {
			<button class="day-nav-today-btn" data-on:click={ getExpr(viewURL(data.Today, data.View)) } title="Jump back to today">
				Today
			</button>
		}
		@SyncButton(data.Day, data.View, false)
	</div>
}

// SyncButton is its own component (stable id) so the force-sync handler
// can morph just this button to a spinner immediately, independently of
// the (possibly much later) full-view refresh once the sync completes.
templ SyncButton(day, view string, syncing bool) {
	<button
		id="sync-btn"
		class="sync-btn"
		data-on:click={ postExpr(syncURL(day, view)) }
		disabled?={ syncing }
		title="Force sync this day's data now (Google Health, and Cronometer once connected)"
	>
		if syncing {
			@iconSpinner()
			Syncing…
		} else {
			@iconSync()
			Sync
		}
	</button>
}
