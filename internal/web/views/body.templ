package views

import "fmt"

// bodyTileBody renders the always-visible Body Measurements form: three
// number inputs bound via Datastar (save on change, mirroring the journal
// autosave pattern but for discrete fields instead of one debounced
// textarea). Each input's initial value is rendered
// straight into the value attribute (like journal.templ's textarea seeds
// data-bind:journalcontent from its own inner content) rather than via a
// separate data-signals declaration — data-bind alone picks that up as the
// signal's starting value. Height is static, so it has no field here — the
// Body Fat % tile reads the latest stored one (bodymeasurement.go's
// latestHeightCm).
templ bodyTileBody(t TileData) {
	if t.Body != nil {
		<div class="body-form">
			<div class="body-field">
				<label for="bm-weight">Weight (kg)</label>
				<input id="bm-weight" type="number" step="0.1" inputmode="decimal" value={ numberAttr(t.Body.WeightKg) } data-bind:bmweight data-on:change={ postExpr(bodyMeasurementSaveURL(t.Body.Day)) }/>
			</div>
			<div class="body-field">
				<label for="bm-waist">Waist (cm)</label>
				<input id="bm-waist" type="number" step="0.1" inputmode="decimal" value={ numberAttr(t.Body.WaistCm) } data-bind:bmwaist data-on:change={ postExpr(bodyMeasurementSaveURL(t.Body.Day)) }/>
			</div>
			<div class="body-field">
				<label for="bm-neck">Neck (cm)</label>
				<input id="bm-neck" type="number" step="0.1" inputmode="decimal" value={ numberAttr(t.Body.NeckCm) } data-bind:bmneck data-on:change={ postExpr(bodyMeasurementSaveURL(t.Body.Day)) }/>
			</div>
			<div class="body-form-footer">
				if t.Body.Error != "" {
					<span class="journal-error">{ t.Body.Error }</span>
				} else if t.Body.SavedAt != "" {
					<span class="body-saved-status">{ t.Body.SavedAt }</span>
				}
			</div>
		</div>
	}
}

// bodyHistoryPage is how many Body History rows show at first, and how many
// more each "Show more" click reveals.
const bodyHistoryPage = 10

// bodyHistoryTileBody renders every logged day newest first, all in the
// HTML but only the first $bhLimit visible — "Show more" just raises the
// limit client-side, no round trip. Rows past the first page also start
// hidden server-side so they don't flash before Datastar initializes.
templ bodyHistoryTileBody(t TileData) {
	<div data-signals={ fmt.Sprintf("{bhLimit: %d}", bodyHistoryPage) }>
		<table class="body-history-table">
			<thead>
				<tr><th>Day</th><th>Weight (kg)</th><th>Waist (cm)</th><th>Neck (cm)</th><th>Body Fat (%)</th></tr>
			</thead>
			<tbody>
				for i, r := range t.BodyHistory {
					<tr
						data-show={ fmt.Sprintf("$bhLimit > %d", i) }
						if i >= bodyHistoryPage {
							style="display: none"
						}
					>
						<td>{ r.Day }</td>
						<td>{ cellValue(r.WeightKg) }</td>
						<td>{ cellValue(r.WaistCm) }</td>
						<td>{ cellValue(r.NeckCm) }</td>
						<td>{ cellValue(r.BodyFatPct) }</td>
					</tr>
				}
			</tbody>
		</table>
		if len(t.BodyHistory) > bodyHistoryPage {
			<button class="body-carry-btn" data-show={ fmt.Sprintf("$bhLimit < %d", len(t.BodyHistory)) } data-on:click={ fmt.Sprintf("$bhLimit += %d", bodyHistoryPage*3) }>
				Show more
			</button>
		}
	</div>
}

// cellValue renders v to one decimal, or a dash when nothing was logged.
func cellValue(v *float64) string {
	if v == nil {
		return "—"
	}
	return fmt.Sprintf("%.1f", *v)
}

// numberAttr renders v as an HTML number-input value attribute: blank when
// nil (nothing recorded yet), otherwise its plain decimal form.
func numberAttr(v *float64) string {
	if v == nil {
		return ""
	}
	return fmt.Sprintf("%g", *v)
}
