package views

import "fmt"

// ActivityDetailFragment and ActivityDetailError both render into
// #detail-panel (inside the shared detail overlay in layout.templ, also
// used by food-log items — see foodlog.templ), so an SSE patch of either
// always lands in the same place.
templ ActivityDetailFragment(d ActivityDetail) {
	<div id="detail-panel">
		<h2>{ humanizeExerciseType(d.Type) }</h2>
		<div class="detail-meta">
			<div><span class="label">Start</span><span>{ d.StartTimeLabel }</span></div>
			<div><span class="label">End</span><span>{ d.EndTimeLabel }</span></div>
			<div><span class="label">Duration</span><span>{ FormatMinutes(d.DurationMinutes) }</span></div>
			<div><span class="label">Calories</span><span>{ fmt.Sprintf("%.0f kcal", d.CaloriesBurned) }</span></div>
			if d.AvgHeartRateBpm != nil {
				<div><span class="label">Avg heart rate</span><span>{ fmt.Sprintf("%.0f bpm", *d.AvgHeartRateBpm) }</span></div>
			}
		</div>
		if len(d.HeartRateSamples) > 0 {
			<h3>Heart rate</h3>
			@templ.Raw(renderLineChartSVG(d.HeartRateSamples, chartInstanceID(fmt.Sprintf("activity_%d", d.ID))))
		} else {
			<p class="tile-empty">No heart rate data linked to this activity.</p>
		}
	</div>
}

templ ActivityDetailError(message string) {
	<div id="detail-panel">
		<p class="journal-error">{ message }</p>
	</div>
}
