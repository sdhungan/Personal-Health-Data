package views

import "fmt"

templ iconExpand() {
	<svg viewBox="0 0 24 24" width="16" height="16" class="icon">
		<path d="M4 10V4h6M20 14v6h-6M4 4l6 6M20 20l-6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
	</svg>
}

templ iconCollapse() {
	<svg viewBox="0 0 24 24" width="16" height="16" class="icon">
		<path d="M9 4v5H4M15 20v-5h5M9 9L3 3M15 15l6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
	</svg>
}

templ iconSync() {
	<svg viewBox="0 0 24 24" width="14" height="14" class="icon">
		<path d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
		<path d="M17 4v4h-4M7 20v-4h4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
	</svg>
}

templ iconSpinner() {
	<svg viewBox="0 0 24 24" width="14" height="14" class="icon icon-spin">
		<path d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
	</svg>
}

func clampPct(pct float64) float64 {
	if pct < 0 {
		return 0
	}
	if pct > 1 {
		return 1
	}
	return pct
}

templ goalGlassSVG(pct float64) {
	<svg viewBox="0 0 100 120" width="80" height="96" class="goal-glass">
		<path d="M25 10 H75 L65 110 H35 Z" fill="none" stroke="currentColor" stroke-width="3"></path>
		<clipPath id="glass-clip">
			<path d="M25 10 H75 L65 110 H35 Z"></path>
		</clipPath>
		<rect
			x="25"
			y={ fmt.Sprintf("%.1f", 110-clampPct(pct)*100) }
			width="50"
			height={ fmt.Sprintf("%.1f", clampPct(pct)*100) }
			fill="currentColor"
			clip-path="url(#glass-clip)"
		></rect>
	</svg>
}
