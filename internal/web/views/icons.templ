	<svg viewBox="0 0 24 24" width="16" height="16" class="icon">
		<path d="M9 4v5H4M15 20v-5h5M9 9L3 3M15 15l6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
	</svg>
}

templ iconSync() {
	<svg viewBox="0 0 24 24" width="14" height="14" class="icon">
		<path d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
		<path d="M17 4v4h-4M7 20v-4h4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
	</svg>
}

templ iconSpinner() {
	<svg viewBox="0 0 24 24" width="14" height="14" class="icon icon-spin">
		<path d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
	</svg>
}

func clampPct(pct float64) float64 {
	if pct < 0 {
		return 0
	}
	if pct > 1 {
		return 1
	}
	return pct
}

// stepRingCircumference matches stepRingSVG's r="26" circle (2*pi*26).
const stepRingCircumference = 163.36

// stepRingSVG is the steps tile's goal-progress ring — replaces the old
// "growing water glass" with the compact circular-progress treatment Apple
// Health uses next to a metric's big number.
templ stepRingSVG(pct float64) {
	<svg viewBox="0 0 64 64" width="44" height="44" class="step-ring">
		<circle cx="32" cy="32" r="26" fill="none" stroke-width="6" class="step-ring-track"></circle>
		<circle
			cx="32"
			cy="32"
			r="26"
			fill="none"
			stroke-width="6"
			stroke-linecap="round"
			stroke-dasharray={ fmt.Sprintf("%.2f %.2f", clampPct(pct)*stepRingCircumference, stepRingCircumference) }
			transform="rotate(-90 32 32)"
			class="step-ring-fill"
		></circle>
	</svg>
}

templ iconCarryForward() {
	<svg viewBox="0 0 24 24" width="14" height="14" class="icon">
		<path d="M12 4v10M12 14l-4-4M12 14l4-4M5 19h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
	</svg>
}

// iconFor dispatches a metricDef/tile Icon key (see internal/web/data.go's
// metricDefs) to its inline SVG, so the badge each tile header renders stays
// driven by data rather than duplicated per-template svg markup.
templ iconFor(name string) {
	switch name {
		case "steps":
			@iconSteps()
		case "flame":
			@iconFlame()
		case "pin":
			@iconPin()
		case "stairs":
			@iconStairs()
		case "bolt":
			@iconBolt()
		case "heart":
			@iconHeart()
		case "drop":
			@iconDrop()
		case "lungs":
			@iconLungs()
		case "moon":
			@iconMoon()
		case "activity":
			@iconActivity()
		case "body":
			@iconBody()
		case "mountain":
			@iconMountain()
		case "chair":
			@iconChair()
		case "thermometer":
			@iconThermometer()
		case "apple":
			@iconApple()
	}
}

templ iconSteps() {
	<svg viewBox="0 0 24 24" width="16" height="16" class="icon">
		<ellipse cx="8" cy="15" rx="3" ry="5" transform="rotate(-20 8 15)" fill="currentColor"></ellipse>
		<ellipse cx="16" cy="8" rx="3" ry="5" transform="rotate(20 16 8)" fill="currentColor"></ellipse>
	</svg>
}

